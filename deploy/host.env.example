# Copy to /opt/tweet-sentiment/host.env on the server, owned by root (mode 600).
# Paths must match the existing edge proxy's mounted webroot and /data directory.
ACME_WEBROOT=/opt/edge-proxy/data/letsencrypt-acme-challenge
CERT_DEST=/opt/edge-proxy/data/custom_ssl/tweet-sentiment
PROXY_CONTAINER=existing-edge-proxy
